{
  "manifest_version": 2,
  "name": "Ears: Bass Boost, EQ Any Audio!",
  "short_name": "Ears",
  "description": "Equalizer for HTML audio and video on web pages.",
  "version": "1.3.13",
  "author": "Shxnqzu",
  "browser_specific_settings": {
    "gecko": {
      "id": "ears-audio-eq@example.org",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent"],
        "optional": []
      }
    }
  },
  "icons": {
    "16": "ears16.png",
    "32": "ears32.png",
    "48": "ears48.png",
    "64": "ears64.png",
    "128": "ears128.png"
  },
  "browser_action": {
    "default_icon": "ears128.png",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "tabs"
  ],
  "optional_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["bg.js"],
    "persistent": true
  },
  "web_accessible_resources": [
    "ears16.png",
    "ears32.png",
    "ears48.png",
    "ears64.png",
    "ears128.png",
    "earstile*.svg",
    "main-world.js"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
